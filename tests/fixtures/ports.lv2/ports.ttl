# SPDX-License-Identifier: GPL-3.0-or-later
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix pg:     <http://lv2plug.in/ns/ext/port-groups#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix units:  <http://lv2plug.in/ns/extensions/units#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix plug:   <urn:openmixer:test:ports#> .

plug:dynamics
    a pg:Group ;
    lv2:symbol "dynamics" ;
    lv2:name "Dynamics" .

plug:bands
    a pg:Group ;
    lv2:symbol "bands" ;
    lv2:name "Bands" .

plug:tone
    a pg:Group ;
    lv2:symbol "tone" ;
    rdfs:label "Tone \"EQ\"" .

<urn:openmixer:test:ports>
    a lv2:Plugin , lv2:CompressorPlugin ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out"
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 2 ; lv2:symbol "threshold" ; lv2:name "Threshold" ;
        pg:group plug:dynamics ; units:unit units:db ;
        lv2:default -18.0 ; lv2:minimum -60.0 ; lv2:maximum 0.0
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 3 ; lv2:symbol "ratio" ; lv2:name "Ratio" ;
        pg:group plug:dynamics ; lv2:default 4 ; lv2:minimum 1 ; lv2:maximum 20 ;
        lv2:portProperty pprops:logarithmic
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 4 ; lv2:symbol "attack" ; lv2:name "Attack" ;
        pg:group plug:dynamics ; units:unit units:ms ;
        lv2:default "10.0"^^xsd:float ; lv2:minimum 0.1 ; lv2:maximum 100.0
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 5 ; lv2:symbol "knee_mode" ; lv2:name "Knee" ;
        pg:group plug:dynamics ; lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 2 ;
        lv2:portProperty lv2:integer , lv2:enumeration
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 6 ; lv2:symbol "sidechain" ; lv2:name "Sidechain" ;
        pg:group plug:dynamics ; lv2:portProperty lv2:toggled
    ] , [
        a lv2:ControlPort , lv2:OutputPort ; lv2:index 7 ; lv2:symbol "reduction" ; lv2:name "Reduction" ;
        pg:group plug:dynamics ; units:unit units:db ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 24.0
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 8 ; lv2:symbol "low" ; lv2:name "Low" ;
        pg:group plug:tone ; units:unit units:hz ; lv2:default 80.0 ; lv2:minimum 20.0 ; lv2:maximum 400.0
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 9 ; lv2:symbol "high" ; lv2:name "High" ;
        pg:group plug:tone ; units:unit [ a units:Unit ; units:symbol "k" ; units:render "%f k" ] ;
        lv2:default 8.0 ; lv2:minimum 2.0 ; lv2:maximum 20.0
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 10 ; lv2:symbol "makeup" ; lv2:name "Makeup" ;
        units:unit units:db ; lv2:default 0.0 ; lv2:minimum -12.0 ; lv2:maximum 24.0
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 11 ; lv2:symbol "debug" ; lv2:name "Debug" ;
        lv2:portProperty pprops:notOnGUI , lv2:toggled
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 12 ; lv2:symbol "loose" ; lv2:name "No range"
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 13 ; lv2:symbol "b1" ; lv2:name "Band 1" ;
        pg:group plug:bands ; lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 14 ; lv2:symbol "b2" ; lv2:name "Band 2" ;
        pg:group plug:bands ; lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 15 ; lv2:symbol "b3" ; lv2:name "Band 3" ;
        pg:group plug:bands ; lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 16 ; lv2:symbol "b4" ; lv2:name "Band 4" ;
        pg:group plug:bands ; lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 17 ; lv2:symbol "b5" ; lv2:name "Band 5" ;
        pg:group plug:bands ; lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 18 ; lv2:symbol "b6" ; lv2:name "Band 6" ;
        pg:group plug:bands ; lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 19 ; lv2:symbol "b7" ; lv2:name "Band 7" ;
        pg:group plug:bands ; lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 20 ; lv2:symbol "b8" ; lv2:name "Band 8" ;
        pg:group plug:bands ; lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 21 ; lv2:symbol "b9" ; lv2:name "Band 9" ;
        pg:group plug:bands ; lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] .
