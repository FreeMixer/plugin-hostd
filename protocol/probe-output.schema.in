{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FreeMixer/plugin-hostd/protocol/probe-output.schema.json",
  "title": "What one probe run of one plugin binary observed",
  "description": "Facts only. A verdict, a rating or a classification is never a field here: plugin-qualify writes those in the qualification record.",
  "type": "object",
  "required": [
    "format",
    "formatVersion",
    "run",
    "plugin",
    "binary",
    "machine",
    "offer",
    "limits",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "plugin-hostd.probe-output"
    },
    "formatVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "run": {
      "type": "object",
      "required": [
        "id",
        "startedAt",
        "elapsedMs",
        "complete",
        "outcome",
        "protocol",
        "tools",
        "via"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "elapsedMs": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "type": "boolean"
        },
        "outcome": {
          "$ref": "#/$defs/outcome"
        },
        "cancelledBy": {
          "enum": [
            "busy",
            "client",
            "shutdown"
          ]
        },
        "reason": {
          "enum": [@PHD_PROBE_REASONS@]
        },
        "protocol": {
          "type": "object",
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "const": "plugin-hostd.probe-protocol"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "tools": {
          "type": "object",
          "required": [
            "runner",
            "child"
          ],
          "additionalProperties": {
            "type": "string"
          },
          "properties": {
            "runner": {
              "type": "string"
            },
            "child": {
              "type": "string"
            },
            "clapCore": {
              "type": "string"
            },
            "interposer": {
              "type": "string"
            }
          }
        },
        "via": {
          "enum": [
            "daemon",
            "runner"
          ]
        },
        "realtime": {
          "$ref": "#/$defs/realtime"
        },
        "memoryLock": {
          "$ref": "#/$defs/memoryLock"
        }
      }
    },
    "plugin": {
      "type": "object",
      "required": [
        "format",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "enum": [
            "clap",
            "lv2"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "vendor": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "ownerPackage": {
          "type": "string"
        }
      }
    },
    "binary": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "layout": {
          "type": "object",
          "required": [
            "scheme",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "scheme": {
              "type": "string"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "unpinnable": {
          "type": "string"
        }
      }
    },
    "descriptor": {
      "$ref": "#/$defs/fileRef"
    },
    "machine": {
      "type": "object",
      "required": [
        "class",
        "profile",
        "pinnedCpus"
      ],
      "additionalProperties": false,
      "properties": {
        "class": {
          "type": "object",
          "required": [
            "arch",
            "family",
            "coreBand",
            "clockBand",
            "preemptRt",
            "cstatesLimited"
          ],
          "additionalProperties": false,
          "properties": {
            "arch": {
              "type": "string"
            },
            "family": {
              "type": "string"
            },
            "coreBand": {
              "enum": [@OMX_MACHINE_CORE_BANDS@]
            },
            "clockBand": {
              "enum": [@OMX_MACHINE_CLOCK_BANDS@]
            },
            "preemptRt": {
              "type": "boolean"
            },
            "cstatesLimited": {
              "type": "boolean"
            }
          }
        },
        "profile": {
          "type": "object",
          "required": [
            "governor",
            "cpuidle",
            "meetsProtocol"
          ],
          "additionalProperties": false,
          "properties": {
            "governor": {
              "type": [
                "string",
                "null"
              ]
            },
            "turbo": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "smt": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "preempt": {
              "type": [
                "string",
                "null"
              ]
            },
            "cpuidle": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "cpu",
                  "state",
                  "latencyUs",
                  "disabled",
                  "usageDelta"
                ],
                "additionalProperties": false,
                "properties": {
                  "cpu": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "state": {
                    "type": "string"
                  },
                  "latencyUs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "disabled": {
                    "type": "boolean"
                  },
                  "usageDelta": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "meetsProtocol": {
              "type": "boolean"
            },
            "unmet": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [@PHD_PROBE_PROFILE_CODES@]
              }
            },
            "declaredName": {
              "type": "string"
            }
          }
        },
        "pinnedCpus": {
          "type": "string",
          "pattern": "^[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*$"
        },
        "reference": {
          "type": "object",
          "required": [
            "rig",
            "image"
          ],
          "additionalProperties": false,
          "properties": {
            "rig": {
              "type": "string"
            },
            "image": {
              "type": "string"
            }
          }
        },
        "local": {
          "description": "Never leaves the machine: an export drops this block.",
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "integer"
            ]
          }
        }
      }
    },
    "offer": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "clapExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lv2Features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lv2Options": {
          "type": "object"
        },
        "realtime": {
          "enum": [@OMX_RESOURCE_THREAD_SCHEDULING@]
        }
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "set",
        "applied",
        "unavailable"
      ],
      "additionalProperties": false,
      "properties": {
        "set": {
          "type": "string"
        },
        "applied": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/limit"
          }
        },
        "unavailable": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "limit",
              "code"
            ],
            "additionalProperties": false,
            "properties": {
              "limit": {
                "$ref": "#/$defs/limitName"
              },
              "code": {
                "type": "string",
                "enum": [@PHD_PROBE_LIMIT_CODES@]
              }
            }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "grid": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/point"
      }
    },
    "behaviour": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lifecycle": {
          "type": "object",
          "required": [
            "cycles",
            "instantiated",
            "failed"
          ],
          "additionalProperties": false,
          "properties": {
            "cycles": {
              "type": "integer",
              "minimum": 0
            },
            "instantiated": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "threads": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "before": {
              "type": "integer"
            },
            "afterFirstInstantiate": {
              "type": "integer"
            },
            "afterAllFreed": {
              "type": "integer"
            }
          }
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rssStartKb": {
              "type": "integer"
            },
            "rssMaxKb": {
              "type": "integer"
            },
            "peakBytes": {
              "type": "integer"
            }
          }
        },
        "features": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "requiredNotOffered": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "extensionsAsked": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "soak": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rate",
              "quantum",
              "seconds"
            ],
            "additionalProperties": false,
            "properties": {
              "rate": {
                "type": "integer"
              },
              "quantum": {
                "type": "integer"
              },
              "seconds": {
                "type": "number"
              },
              "windows": {
                "type": "integer"
              },
              "nonFiniteWindows": {
                "type": "integer"
              },
              "silentWindows": {
                "type": "integer"
              },
              "rssGrowthKb": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "crash": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "signal": {
          "type": "string"
        },
        "topFrame": {
          "type": "string"
        },
        "frameObject": {
          "type": "string"
        },
        "sanitizer": {
          "type": "string"
        }
      }
    },
    "logs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileRef"
      }
    }
  },
  "allOf": [
    {
      "description": "the class the plugin was offered is the class it was measured in",
      "if": {
        "required": [
          "run"
        ],
        "properties": {
          "run": {
            "required": [
              "realtime"
            ],
            "properties": {
              "realtime": {
                "properties": {
                  "class": {
                    "const": "fifo"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "offer": {
            "required": [
              "realtime"
            ],
            "properties": {
              "realtime": {
                "const": "fifo"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "offer": {
            "properties": {
              "realtime": {
                "const": "none"
              }
            }
          }
        }
      }
    }
  ],
  "not": {
    "anyOf": [
      {
        "required": [
          "verdict"
        ]
      },
      {
        "required": [
          "verdicts"
        ]
      },
      {
        "required": [
          "rating"
        ]
      },
      {
        "required": [
          "hosting"
        ]
      }
    ]
  },
  "$defs": {
    "voiceBasis": {
      "enum": [@OMX_MEASUREMENT_VOICE_BASES@]
    },
    "realtime": {
      "description": "How the measured child was scheduled: the class and priority are what the kernel reported for it after its exec (observed), never what was asked for; a class of none is a valid measurement taken without real time, and says why.",
      "type": "object",
      "required": [
        "class",
        "priority",
        "requested",
        "grantedBy"
      ],
      "additionalProperties": false,
      "properties": {
        "class": {
          "enum": [@OMX_RESOURCE_THREAD_SCHEDULING@]
        },
        "priority": {
          "type": "integer",
          "minimum": 0
        },
        "requested": {
          "type": "integer",
          "minimum": 1
        },
        "grantedBy": {
          "enum": [@PHD_PROBE_RT_GRANTS@]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "capabilityBound": {
          "description": "Whether the measured child, once exec'd, holds no capability in its permitted or effective set (as the kernel reports it), so it cannot raise RLIMIT_RTPRIO, RLIMIT_RTTIME or RLIMIT_MEMLOCK again; false for a root runner that could not drop its bounding set.",
          "type": "boolean"
        },
        "observed": {
          "type": "object",
          "required": [
            "policy",
            "priority"
          ],
          "additionalProperties": false,
          "properties": {
            "policy": {
              "enum": [@PHD_PROBE_SCHED_POLICIES@]
            },
            "priority": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "class": {
                "const": "fifo"
              }
            }
          },
          "then": {
            "required": [
              "observed"
            ],
            "properties": {
              "priority": {
                "minimum": 1
              },
              "grantedBy": {
                "not": {
                  "const": "none"
                }
              },
              "observed": {
                "properties": {
                  "policy": {
                    "const": "fifo"
                  },
                  "priority": {
                    "minimum": 1
                  }
                }
              }
            }
          },
          "else": {
            "required": [
              "reason"
            ],
            "properties": {
              "priority": {
                "const": 0
              },
              "grantedBy": {
                "const": "none"
              }
            }
          }
        }
      ]
    },
    "memoryLock": {
      "description": "Whether the measured child's memory was locked (mlockall of every current and future page) within limitBytes, its RLIMIT_MEMLOCK (null: unlimited); a child that was not locked says why.",
      "type": "object",
      "required": [
        "locked",
        "limitBytes"
      ],
      "additionalProperties": false,
      "properties": {
        "locked": {
          "type": "boolean"
        },
        "limitBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "locked": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ]
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "outcome": {
      "enum": [@PHD_PROBE_OUTCOMES@]
    },
    "limitName": {
      "enum": [@PHD_PROBE_LIMIT_NAMES@]
    },
    "limit": {
      "type": "object",
      "required": [
        "limit",
        "by"
      ],
      "additionalProperties": false,
      "properties": {
        "limit": {
          "$ref": "#/$defs/limitName"
        },
        "value": {
          "type": [
            "integer",
            "string"
          ]
        },
        "unit": {
          "enum": [
            "s",
            "ms",
            "bytes",
            "count",
            "us"
          ]
        },
        "by": {
          "enum": [@PHD_PROBE_LIMIT_MECHANISMS@]
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "step",
        "outcome",
        "elapsedMs"
      ],
      "additionalProperties": false,
      "properties": {
        "step": {
          "enum": [@PHD_PROBE_STEPS@]
        },
        "rate": {
          "type": "integer"
        },
        "quantum": {
          "type": "integer"
        },
        "outcome": {
          "$ref": "#/$defs/outcome"
        },
        "elapsedMs": {
          "type": "integer",
          "minimum": 0
        },
        "signal": {
          "type": "string"
        },
        "exitStatus": {
          "type": "integer"
        },
        "limit": {
          "$ref": "#/$defs/limitName"
        },
        "hostingCode": {
          "type": "string",
          "pattern": "^hosting\\.[a-z0-9.-]+$"
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "point": {
      "type": "object",
      "required": [
        "rate",
        "quantum",
        "outcome"
      ],
      "additionalProperties": false,
      "properties": {
        "rate": {
          "type": "integer",
          "minimum": 1
        },
        "quantum": {
          "type": "integer",
          "minimum": 1
        },
        "outcome": {
          "$ref": "#/$defs/outcome"
        },
        "latency": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "declaredFrames": {
              "type": "integer",
              "minimum": 0
            },
            "measuredFrames": {
              "type": "integer",
              "minimum": 0
            },
            "method": {
              "enum": [@OMX_MEASUREMENT_LATENCY_METHODS@]
            },
            "heard": {
              "description": "A note-onset latency's: whether the note sounded, so an onset that never came is not read as one.",
              "type": "boolean"
            }
          }
        },
        "memory": {
          "description": "What one instance holds at this rate and quantum: how far the resident set of the child grew from before the plugin loaded, in KB, step by step. A figure the child could not take is absent, never 0; unmeasuredReason says why when none could be.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "afterInstantiateKb": {
              "description": "After the plugin was created and initialised.",
              "type": "integer",
              "minimum": 0
            },
            "afterActivateKb": {
              "description": "After it was activated.",
              "type": "integer",
              "minimum": 0
            },
            "atRestKb": {
              "description": "After it processed and came to rest, activated.",
              "type": "integer",
              "minimum": 0
            },
            "notesHeldKb": {
              "description": "With notes held, for an instrument.",
              "type": "integer",
              "minimum": 0
            },
            "secondInstanceKb": {
              "description": "What a second instance of the same plugin added once it had done the same, so what one instance costs is told from what all of them share.",
              "type": "integer",
              "minimum": 0
            },
            "basis": {
              "description": "How many notes notesHeldKb holds: the instrument's declared voices, or the count the run was told to probe.",
              "$ref": "#/$defs/voiceBasis"
            },
            "unmeasuredReason": {
              "type": "string"
            },
            "unmeasuredDetail": {
              "type": "string"
            }
          }
        },
        "cost": {
          "type": "object",
          "required": [
            "unit",
            "median",
            "percentile",
            "blocks",
            "warmupBlocks"
          ],
          "additionalProperties": false,
          "properties": {
            "unit": {
              "const": "ns-per-sample"
            },
            "median": {
              "type": "number",
              "minimum": 0
            },
            "percentile": {
              "type": "object",
              "required": [
                "p",
                "value"
              ],
              "additionalProperties": false,
              "properties": {
                "p": {
                  "type": "number",
                  "exclusiveMinimum": 50,
                  "maximum": 100
                },
                "value": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "min": {
              "type": "number",
              "minimum": 0
            },
            "max": {
              "type": "number",
              "minimum": 0
            },
            "iqr": {
              "type": "number",
              "minimum": 0
            },
            "blocks": {
              "type": "integer",
              "minimum": 1
            },
            "warmupBlocks": {
              "type": "integer",
              "minimum": 0
            },
            "warmupMedian": {
              "type": "number",
              "minimum": 0
            },
            "timingFloorNsPerBlock": {
              "type": "number",
              "minimum": 0
            },
            "silentOutput": {
              "type": "boolean"
            },
            "samples": {
              "$ref": "#/$defs/fileRef"
            },
            "voices": {
              "description": "An instrument's: the notes it held down while it was timed, and why that many.",
              "type": "object",
              "required": [
                "held",
                "basis"
              ],
              "additionalProperties": false,
              "properties": {
                "held": {
                  "type": "integer",
                  "minimum": 1
                },
                "basis": {
                  "$ref": "#/$defs/voiceBasis"
                },
                "capacity": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "voiceCurve": {
              "description": "An instrument's: its cost at each count of notes held (1, 8, 16, 32, 64 up to what it can hold), so an estimate scales by the voices a patch sounds (plugin-qualify#203). Format 1.4.",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "held",
                  "median",
                  "percentile"
                ],
                "additionalProperties": false,
                "properties": {
                  "held": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "median": {
                    "type": "number",
                    "minimum": 0
                  },
                  "percentile": {
                    "type": "object",
                    "required": [
                      "p",
                      "value"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "p": {
                        "type": "number",
                        "exclusiveMinimum": 50,
                        "maximum": 100
                      },
                      "value": {
                        "type": "number",
                        "minimum": 0
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "rtSafety": {
          "type": "object",
          "required": [
            "interposer"
          ],
          "additionalProperties": false,
          "properties": {
            "interposer": {
              "type": "boolean"
            },
            "swept": {
              "type": "boolean"
            },
            "sweepApplicable": {
              "type": "boolean"
            },
            "blocks": {
              "type": "integer"
            },
            "allocations": {
              "type": "integer",
              "minimum": 0
            },
            "locks": {
              "type": "integer",
              "minimum": 0
            },
            "syscalls": {
              "type": "integer",
              "minimum": 0
            },
            "threadViolations": {
              "type": "integer",
              "minimum": 0
            },
            "processErrors": {
              "type": "integer",
              "minimum": 0
            },
            "events": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "noteSweep": {
          "type": "object",
          "required": [
            "applicable"
          ],
          "additionalProperties": false,
          "properties": {
            "applicable": {
              "type": "boolean"
            },
            "dialect": {
              "type": "string"
            },
            "allocations": {
              "type": "integer",
              "minimum": 0
            },
            "locks": {
              "type": "integer",
              "minimum": 0
            },
            "syscalls": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "fileRef": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        }
      }
    }
  }
}
