{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freemixer.org/schemas/org.openmixer.preset.schema.json",
  "title": "org.openmixer.preset",
  "description": "A user preset file, as a worker writes it for preset_save and reads it for preset_load and preset_show (docs/presets.md). /1 is params-only and stays valid; /2 adds the state body, additively. Unknown fields are allowed and a writer keeps them; an unknown format version is refused, never guessed.",
  "type": "object",
  "required": ["format", "plugin", "id", "name"],
  "properties": {
    "format": {"enum": ["org.openmixer.preset/1", "org.openmixer.preset/2"]},
    "plugin": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "fingerprint": {"$ref": "#/$defs/fingerprint"}
      }
    },
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string"},
    "alias": {"type": "string", "minLength": 1, "maxLength": 12},
    "bank": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "description": {"type": "string"},
    "createdAt": {"$ref": "#/$defs/utc"},
    "modifiedAt": {"$ref": "#/$defs/utc"},
    "carries": {"enum": ["params", "params+state", "state"]},
    "params": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["symbol", "value"],
        "properties": {
          "symbol": {"type": "string", "minLength": 1},
          "unit": {"type": "string"},
          "value": {"type": "number"}
        }
      }
    },
    "state": {
      "type": "object",
      "required": ["encoding", "context", "bytes"],
      "properties": {
        "encoding": {"const": "base64"},
        "context": {"enum": ["preset", "project", "lv2"]},
        "bytes": {"$ref": "#/$defs/base64"},
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "encoding", "bytes"],
            "properties": {
              "name": {"type": "string", "minLength": 1, "pattern": "^[^/]+$"},
              "encoding": {"const": "base64"},
              "bytes": {"$ref": "#/$defs/base64"}
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"format": {"const": "org.openmixer.preset/1"}}},
      "then": {
        "required": ["params"],
        "properties": {"carries": {"const": "params"}},
        "not": {"required": ["state"]}
      }
    },
    {
      "if": {"properties": {"format": {"const": "org.openmixer.preset/2"}}},
      "then": {
        "required": ["carries"],
        "properties": {"plugin": {"required": ["id", "version", "fingerprint"]}}
      }
    },
    {
      "if": {"required": ["carries"], "properties": {"carries": {"const": "params"}}},
      "then": {"required": ["params"], "not": {"required": ["state"]}}
    },
    {
      "if": {"required": ["carries"], "properties": {"carries": {"const": "params+state"}}},
      "then": {"required": ["params", "state"]}
    },
    {
      "if": {"required": ["carries"], "properties": {"carries": {"const": "state"}}},
      "then": {"required": ["state"]}
    }
  ],
  "$defs": {
    "fingerprint": {
      "description": "the plugin's descriptor fingerprint: its layout pin, <scheme>:<sha256> of a scheme this version knows",
      "type": "string",
      "pattern": "^omx-layout/1:[0-9a-f]{64}$"
    },
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
    "base64": {"type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$"}
  }
}
