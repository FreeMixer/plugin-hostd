index 00000000..c3ef0ce1
--- /dev/null
+++ b/zyngine/zynthian_plugind_chain.py
@@ -0,0 +1,400 @@
+# -*- coding: utf-8 -*-
+# ********************************************************************
+# ZYNTHIAN PROJECT: plugin-hostd chain (zynthian_plugind_chain)
+#
+# A chain's audio slots realised on plugin-hostd as one chain line: the
+# connection to the daemon, the instance numbers, the chain verb and its
+# read-back, chain_get.
+#
+# Copyright (C) 2026 Pau Aliagas <linuxnow@gmail.com>
+#
+# ********************************************************************
+#
+# This program is free software; you can redistribute it and/or
+# modify it under the terms of the GNU General Public License as
+# published by the Free Software Foundation; either version 3 of
+# the License, or any later version.
+#
+# This program is distributed in the hope that it will be useful,
+# but WITHOUT ANY WARRANTY; without even the implied warranty of
+# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+# GNU General Public License for more details.
+#
+# For a full copy of the GNU General Public License see the LICENSE.txt file.
+#
+# ********************************************************************
+
+import os
+import socket
+import logging
+import threading
+import subprocess
+from time import sleep
+
+# The refusals of the chain, by name. None is a protocol code: they are said here, with the slot they name.
+PARALLEL_SLOT_REFUSED = "PARALLEL_SLOT_REFUSED"  # a parallel slot holds a plugind processor (until omx-plugins#229)
+RUN_SPLIT = "PLUGIND_RUN_SPLIT"  # a processor plugin-hostd does not run sits between two it runs
+CHAIN_REFUSED = "PLUGIND_CHAIN_REFUSED"  # the daemon refused the chain line
+READBACK_MISMATCH = "PLUGIND_READBACK_MISMATCH"  # chain_get does not answer the order the line declared
+CHAIN_GET_ABSENT = "PLUGIND_CHAIN_GET_ABSENT"  # the daemon predates chain_get, the floor (plugin-hostd#162)
+DAEMON_LOST = "PLUGIND_DAEMON_LOST"  # the connection to the daemon failed mid-command (a restart, a timeout)
+
+# the daemon's code for a chain no chain line declared (plugin-hostd protocol.h, PHD_ERR_NO_SUCH_CHAIN)
+NO_SUCH_CHAIN = -522
+# the rows of worker_list whose worker runs a chain in one client: the members' routes are the chain's own
+NATIVE_CHAIN_ROWS = ("clap", "lv2-clap")
+
+
+class plugind_chain_refused(Exception):
+    def __init__(self, code, slot=None, detail=""):
+        where = f" (audio slot {slot})" if slot is not None else ""
+        super().__init__(f"{code}{where}{': ' + detail if detail else ''}")
+        self.code = code
+        self.slot = slot
+
+# ------------------------------------------------------------------------------
+# One connection to plugin-hostd, shared by every plugind engine and chain
+# ------------------------------------------------------------------------------
+
+
+class plugind_client:
+    """Commands on PLUGIND_PORT (mod-host's 5555), feedback on the port after it; starts the daemon if none answers."""
+
+    def __init__(self, port=None):
+        self.port = int(port or os.environ.get("PLUGIND_PORT", 5555))
+        self.lock = threading.Lock()
+        self.output_handlers = {}
+        self.chain_handlers = {}
+        self.proc = None
+        if not self.connectable():
+            cmd = [os.environ.get("PLUGIND_BIN", "plugin-hostd"), "-n", "-p", str(self.port)]
+            logging.info(f"Starting plugin-hostd => {cmd}")
+            self.proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+            for _ in range(50):
+                if self.connectable():
+                    break
+                sleep(0.1)
+        # mod-host's protocol: a controller opens the feedback port before its first command
+        self.fb = socket.create_connection(("127.0.0.1", self.port + 1))
+        self.sock = socket.create_connection(("127.0.0.1", self.port))
+        # a daemon that never answers is a lost one: no command waits past PLUGIND_TIMEOUT seconds
+        self.sock.settimeout(float(os.environ.get("PLUGIND_TIMEOUT", 30)))
+        threading.Thread(target=self.feedback_task, daemon=True).start()
+
+    def connectable(self):
+        try:
+            socket.create_connection(("127.0.0.1", self.port), timeout=0.2).close()
+            return True
+        except OSError:
+            return False
+
+    def cmd(self, line):
+        with self.lock:
+            try:
+                self.sock.sendall(line.encode() + b"\0")
+                buf = b""
+                while not buf.endswith(b"\0"):
+                    data = self.sock.recv(65536)
+                    if not data:
+                        break
+                    buf += data
+            except OSError:
+                # a reply cut by a restart or a timeout is never read as the next command's
+                self.sock.close()
+                raise
+        reply = buf.rstrip(b"\0").decode("utf-8", "replace")
+        logging.debug(f"plugind: {line} => {reply}")
+        return reply
+
+    def feedback_task(self):
+        buf = b""
+        while True:
+            data = self.fb.recv(65536)
+            if not data:
+                return
+            buf += data
+            *msgs, buf = buf.split(b"\0")
+            for msg in msgs:
+                words = msg.decode("utf-8", "replace").split()
+                # output_set <instance> <symbol> <value>: a monitored output (meter) moved
+                if len(words) == 4 and words[0] == "output_set":
+                    handler = self.output_handlers.get(int(words[1]))
+                    if handler:
+                        handler(words[2], float(words[3]))
+                # the meters of one cycle are out: ask for the next, as mod-ui does (mod/host.py send_output_data_ready)
+                elif words and words[0] == "data_finish":
+                    threading.Thread(target=self.cmd, args=("output_data_ready",), daemon=True).start()
+                # chain_formed <chain> <worker> <instance>,... and worker_died <worker> <pid> <how> <instance>,...: what
+                # a chain's worker runs may have changed (a quarantine, a rejoin, a split)
+                elif words and words[0] in ("chain_formed", "worker_died"):
+                    for handler in list(self.chain_handlers.values()):
+                        threading.Thread(target=handler, args=(words,), daemon=True).start()
+
+
+def resp_code(reply):
+    words = reply.split()
+    try:
+        return int(words[1]) if len(words) > 1 and words[0] == "resp" else None
+    except ValueError:
+        return None
+
+
+_client = None
+
+
+def client():
+    global _client
+    if _client is None:
+        _client = plugind_client()
+    return _client
+
+
+def set_client(c):
+    """A test, or a host with its own connection, hands the chain the client to use."""
+    global _client
+    _client = c
+
+# ------------------------------------------------------------------------------
+# Instance numbers
+# ------------------------------------------------------------------------------
+
+
+instances = set()
+
+
+def alloc_instance():
+    n = min(set(range(len(instances) + 1)) - instances)
+    instances.add(n)
+    return n
+
+
+def free_instance(n):
+    instances.discard(n)
+
+
+def add_line(uri, instance):
+    """The add line; PLUGIND_PLACEMENT (own, pool:<name>, ...) is the daemon's own placement word, empty by default."""
+    placement = os.environ.get("PLUGIND_PLACEMENT", "")
+    return f"add {uri} {instance}" + (f" {placement}" if placement else "")
+
+
+def jalv_line(instance, cmd):
+    """A jalv command line the jalv base class writes, said in the daemon's protocol; None for one with nothing to say
+    ("monitors": the meters come as output_set feedback)."""
+    if cmd.startswith("preset "):
+        return f"preset_load {instance} {cmd[7:]}"
+    if "=" in cmd and " " not in cmd:
+        symbol, value = cmd.split("=", 1)
+        if symbol == ":bypass":
+            # the host's bypass, mod-host's verb: the plugin has no bypass port of its own
+            return f"bypass {instance} {1 if float(value) >= 0.5 else 0}"
+        return f"param_set {instance} {symbol} {value}"
+    return None
+
+# ------------------------------------------------------------------------------
+# The chain line
+# ------------------------------------------------------------------------------
+
+
+def is_plugind(processor):
+    return getattr(processor.engine, "plugind", False)
+
+
+def read_chain(chain_id):
+    """chain_get: (worker, declared, running), None for a chain no line declared; raises CHAIN_GET_ABSENT when the
+    daemon has no chain_get"""
+    reply = client().cmd(f"chain_get {chain_id}")
+    code = resp_code(reply)
+    if code == NO_SUCH_CHAIN:
+        return None
+    words = reply.split()
+    if code != 0 or len(words) != 5:
+        raise plugind_chain_refused(CHAIN_GET_ABSENT, None, f"chain_get {chain_id} => {reply}")
+
+    def ids(word):
+        return [] if word == "-" else [int(x) for x in word.split(",")]
+    return words[2], ids(words[3]), ids(words[4])
+
+
+def worker_row(worker):
+    """the row (format) of a worker in worker_list"""
+    for rec in client().cmd("worker_list").split()[2:]:
+        head = rec.rsplit(":", 1)[0].split(":")
+        if head[0] == worker:
+            return head[2]
+    return None
+
+
+class plugind_chain:
+    """One Zynthian chain's plugind processors as one chain line of plugin-hostd."""
+
+    def __init__(self, chain_id):
+        self.id = chain_id
+        self.declared = []  # the instances of the last line, in order
+        self.running = []  # the instances its worker runs, as chain_get last answered
+        self.native = True  # the worker runs the chain in one client
+        self.refusal = None  # the code of the last refusal, None when the last realisation had none
+        # one realisation at a time: the rebuild of a Zynthian edit and the one a feedback event asks for
+        self.lock = threading.RLock()
+
+    # ---------------------------------------------------------------------------
+    # The plan: what the slots ask for, with nothing sent
+    # ---------------------------------------------------------------------------
+
+    def check(self, audio_slots):
+        """Raise PARALLEL_SLOT_REFUSED for a parallel slot that holds a plugind processor."""
+        for i, slot in enumerate(audio_slots):
+            if len(slot) > 1 and any(is_plugind(p) for p in slot):
+                raise plugind_chain_refused(PARALLEL_SLOT_REFUSED, i, ", ".join(p.get_jackname() for p in slot))
+
+    def members(self, audio_slots):
+        """The first run of single plugind slots, in slot order, and the slot of a plugind processor after a foreign one
+        (None when the run holds every plugind processor)."""
+        run, split, ended = [], None, False
+        for i, slot in enumerate(audio_slots):
+            if is_plugind(slot[0]):
+                if ended:
+                    split = i if split is None else split
+                else:
+                    run.append(slot[0])
+            elif run:
+                ended = True
+        return run, split
+
+    # ---------------------------------------------------------------------------
+    # Realisation
+    # ---------------------------------------------------------------------------
+
+    def realise(self, audio_slots, audio_routes):
+        """Declare the slots' order as one chain line, read it back; returns the routes left to autoconnect."""
+        self.refusal = None
+        if not any(is_plugind(p) for slot in audio_slots for p in slot) and not self.declared:
+            return audio_routes
+        self.check(audio_slots)
+        run, split = self.members(audio_slots)
+        ids = [p.engine.instance for p in run]
+        if not ids:
+            if self.declared:
+                client().cmd(f"chain_clear {self.id}")
+                self.read_back()
+                if self.declared:
+                    raise plugind_chain_refused(READBACK_MISMATCH, None, f"sent chain_clear, chain_get {self.declared}")
+            self.declared = self.running = []
+            return audio_routes
+        if ids != self.declared:
+            # the read-back is the floor: a daemon without it is never sent a line it could not be asked about
+            read_chain(self.id)
+            reply = client().cmd(f"chain {self.id} " + " ".join(str(n) for n in ids))
+            code = resp_code(reply)
+            if code is None or code < 0:
+                raise plugind_chain_refused(CHAIN_REFUSED, None, f"chain {self.id} => {reply}")
+            self.declared = ids
+        self.read_back()
+        if self.declared != ids:
+            raise plugind_chain_refused(READBACK_MISMATCH, None, f"sent {ids}, chain_get {self.declared}")
+        if split is not None:
+            # the run after a foreign processor runs one worker each, as autoconnect routes it: logged, not refused
+            self.refusal = RUN_SPLIT
+            logging.error(f"plugind chain {self.id}: {RUN_SPLIT} (audio slot {split}): it runs outside the chain line")
+        return self.routes(run, audio_routes)
+
+    def read_back(self):
+        got = read_chain(self.id)
+        worker, self.declared, self.running = got if got else (None, [], [])
+        self.native = worker in (None, "-") or worker_row(worker) in NATIVE_CHAIN_ROWS
+
+    def on_event(self, words, rebuild):
+        """chain_formed of this chain with another running order, or worker_died of a worker that ran a member: the
+        routes follow what runs now"""
+        if words[0] == "chain_formed" and len(words) == 4 and int(words[1]) == self.id:
+            running = [] if words[3] == "-" else [int(x) for x in words[3].split(",")]
+            if running != self.running:
+                rebuild()
+        elif words[0] == "worker_died" and len(words) == 5 and words[4] != "-":
+            if {int(x) for x in words[4].split(",")} & set(self.running):
+                rebuild()
+
+    def routes(self, run, audio_routes):
+        """The chain's routes with the run's inner links taken out: the running head's client takes the run's input,
+        and whatever the run fed is fed by it. A worker that runs no chain in one client, or no chain's worker at all
+        (its members split by a death), keeps the clients' routes."""
+        if not self.native or not self.running:
+            return audio_routes
+        names = [p.get_jackname() for p in run]
+        head = f"effect_{self.running[0]}" if self.running else None
+        routes = {}
+        for dst, sources in audio_routes.items():
+            if dst in names:
+                if dst == names[0] and head:
+                    routes[head] = list(sources)
+                continue
+            fed = []
+            for s in sources:
+                s = head if s in names else s
+                if s and s not in fed:
+                    fed.append(s)
+            routes[dst] = fed
+        return routes
+
+
+chains = {}
+
+
+def chain_of(chain):
+    if chain.chain_id not in chains:
+        pc = chains[chain.chain_id] = plugind_chain(chain.chain_id)
+        # a new order of the chain's worker (a member quarantined, rejoined, split): its routes follow what runs
+        client().chain_handlers[chain.chain_id] = lambda words: pc.on_event(words, chain.rebuild_audio_graph)
+    return chains[chain.chain_id]
+
+
+def realise_chain(chain, audio_routes):
+    """zynthian_chain.rebuild_audio_graph's hook: the routes autoconnect is left with. A refusal logs its code and
+    leaves the chain's routes, less every destination a parallel slot's members would feed together: JACK never sums
+    them at one input. The guard before a slot forms (accepts) keeps that from happening. It runs with autoconnect's
+    lock held, so it never raises: a daemon lost mid-command (a restart, a timeout) logs one line and leaves the routes
+    as Zynthian built them, the next realisation declaring the line again."""
+    try:
+        pc = chain_of(chain)
+        with pc.lock:
+            return pc.realise(chain.audio_slots, audio_routes)
+    except plugind_chain_refused as e:
+        pc.refusal = e.code
+        logging.error(f"plugind chain {chain.chain_id}: {e}")
+        routes = dict(audio_routes)
+        for slot in chain.audio_slots:
+            if len(slot) > 1:
+                members = sorted(p.get_jackname() for p in slot)
+                for dst in [d for d, sources in routes.items() if sorted(sources) == members]:
+                    routes.pop(dst)
+        return routes
+    except Exception as e:
+        pc = chains.get(chain.chain_id)
+        if pc:
+            # what the lost daemon held is not known: the next realisation declares the line again
+            pc.refusal, pc.declared, pc.running = DAEMON_LOST, [], []
+        logging.error(f"plugind chain {chain.chain_id}: {DAEMON_LOST}: {type(e).__name__}: {e}")
+        return audio_routes
+
+
+def accepts(chain, audio_slots):
+    """zynthian_chain.nudge_processor's guard: False, with the code logged, for slots the chain could not realise."""
+    if not any(is_plugind(p) for slot in audio_slots for p in slot):
+        return True
+    try:
+        chain_of(chain).check(audio_slots)
+        return True
+    except plugind_chain_refused as e:
+        logging.error(f"plugind chain {chain.chain_id}: {e}")
+        return False
+
+
+def move_past(slots, cur, up):
+    """zynthian_chain.nudge_processor's move: the neighbour slot a single plugind processor swaps with when it holds
+    one plugind processor too (a parallel slot of them is refused, so a nudge that would merge them moves past),
+    None when the nudge is Zynthian's own."""
+    nb = cur - 1 if up else cur + 1
+    if 0 <= nb < len(slots) and len(slots[cur]) == 1 and len(slots[nb]) == 1 and is_plugind(slots[cur][0]) and \
+            is_plugind(slots[nb][0]):
+        return nb
+    return None
