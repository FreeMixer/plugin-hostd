+++ b/src/verbs.c
@@ -165,7 +165,7 @@ static char *handle(char *line, char **tok, int ntok)
      * as mod-host answers a word that is no verb. */
     if (!strcmp(verb, OMX_VERB_HELLO))
         return ntok < 2 ? strdup(MESSAGE_FEW_ARGUMENTS) : session_hello(tok, ntok);
-    if (verb[0] == '@')
+    if (verb[0] == '\1')
