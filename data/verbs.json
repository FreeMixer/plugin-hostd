{
  "$schema": "../schema/omx-contract.schema.json",
  "requires": {
    "omx-contract-schema": ">= 3.3.0",
    "omx-clap-core": ">= 0.23.0"
  },
  "PLUGIN_HOSTD_REPLY_CODES": {
    "kind": "codes",
    "since": "0.12.0",
    "doc": "The refusals only plugin-hostd answers by number (include/plugin-hostd/protocol.h PHD_ERRORS). The numbers it answers in common with omx-clap-host are omx-clap-core's HOST_REPLY_CODES.",
    "codes": {
      "placementInvalid": {
        "code": "reply.plugin-hostd.placement-invalid",
        "resp": -501,
        "doc": "not a placement, or not valid here"
      },
      "noBackend": {
        "code": "reply.plugin-hostd.no-backend",
        "resp": -502,
        "doc": "no worker program for the scheme"
      },
      "workerSpawn": {
        "code": "reply.plugin-hostd.worker-spawn",
        "resp": -503,
        "doc": "the worker is not up"
      },
      "replay": {
        "code": "reply.plugin-hostd.replay",
        "resp": -504,
        "doc": "the name of a refused replay on stderr, never a reply"
      },
      "gaveUp": {
        "code": "reply.plugin-hostd.gave-up",
        "resp": -505,
        "doc": "the storm bound is spent for that placement"
      },
      "noSuchWorker": {
        "code": "reply.plugin-hostd.no-such-worker",
        "resp": -506,
        "doc": "no such worker"
      },
      "verbDropped": {
        "code": "reply.plugin-hostd.verb-dropped",
        "resp": -507,
        "doc": "the worker died on this very command and the daemon dropped it"
      },
      "pinBinaryMismatch": {
        "code": "reply.plugin-hostd.pin-binary-mismatch",
        "resp": -509,
        "doc": "a pinned file is missing or its SHA-256 differs"
      },
      "lv2AdapterRefused": {
        "code": "reply.plugin-hostd.lv2-adapter-refused",
        "resp": -512,
        "doc": "the lv2-clap worker's LV2 adapter cannot run this plugin"
      },
      "noPresetList": {
        "code": "reply.plugin-hostd.no-preset-list",
        "resp": -515,
        "doc": "the instance's worker cannot list the plugin's presets"
      },
      "pinRefused": {
        "code": "reply.plugin-hostd.pin-refused",
        "resp": -516,
        "doc": "the plugin's pin carries verdict=refused"
      },
      "chainUnknownInstance": {
        "code": "reply.plugin-hostd.chain-unknown-instance",
        "resp": -518,
        "doc": "a member is an instance no add made"
      },
      "chainDuplicate": {
        "code": "reply.plugin-hostd.chain-duplicate",
        "resp": -519,
        "doc": "an instance is named twice in one chain"
      },
      "chainInstanceBusy": {
        "code": "reply.plugin-hostd.chain-instance-busy",
        "resp": -520,
        "doc": "a member is already in another chain"
      },
      "chainMixedFormat": {
        "code": "reply.plugin-hostd.chain-mixed-format",
        "resp": -521,
        "doc": "no one worker program runs every member"
      },
      "noSuchChain": {
        "code": "reply.plugin-hostd.no-such-chain",
        "resp": -522,
        "doc": "a chain no chain line declared"
      },
      "presetNotOffered": {
        "code": "reply.plugin-hostd.preset-not-offered",
        "resp": -523,
        "doc": "a stable name the plugin does not offer"
      },
      "presetInvalid": {
        "code": "reply.plugin-hostd.preset-invalid",
        "resp": -524,
        "doc": "a preset file or path that is not the preset format"
      },
      "presetNeedsState": {
        "code": "reply.plugin-hostd.preset-needs-state",
        "resp": -525,
        "doc": "a preset file that carries state for a worker that cannot take state"
      },
      "presetPluginChanged": {
        "code": "reply.plugin-hostd.preset-plugin-changed",
        "resp": -526,
        "doc": "the preset file's plugin id, version or fingerprint is not the instance's"
      },
      "loadRefused": {
        "code": "reply.plugin-hostd.load-refused",
        "resp": -527,
        "doc": "the plugin refused the preset or the state its file carries"
      },
      "dirNotWritable": {
        "code": "reply.plugin-hostd.dir-not-writable",
        "resp": -528,
        "doc": "descriptor_dir or qualification_dir cannot be made or written"
      },
      "descriptorAbsent": {
        "code": "reply.plugin-hostd.descriptor-absent",
        "resp": -529,
        "doc": "no descriptor (panel) for the plugin's binary as it is now"
      },
      "descriptorPending": {
        "code": "reply.plugin-hostd.descriptor-pending",
        "resp": -530,
        "doc": "the scan its add started has not written the descriptor (panel) yet"
      },
      "descriptorScanFailed": {
        "code": "reply.plugin-hostd.descriptor-scan-failed",
        "resp": -531,
        "doc": "the plugin's last scan wrote no descriptor (panel)"
      },
      "noSuchPlan": {
        "code": "reply.plugin-hostd.no-such-plan",
        "resp": -532,
        "doc": "a chain no plan verb planned"
      },
      "noRecord": {
        "code": "reply.plugin-hostd.no-record",
        "resp": -533,
        "doc": "no qualification record names the plugin"
      },
      "noCell": {
        "code": "reply.plugin-hostd.no-cell",
        "resp": -534,
        "doc": "the plugin's qualification records hold no cost and latency at that rate and quantum"
      },
      "unknownPlugin": {
        "code": "reply.plugin-hostd.unknown-plugin",
        "resp": -535,
        "doc": "the uri names no plugin installed here"
      }
    }
  },
  "PLUGIN_HOSTD_VERBS": {
    "kind": "verbs",
    "since": "0.12.0",
    "doc": "The verbs plugin-hostd adds to mod-host's protocol and answers itself, and the ones it sends a worker (README.md, Verbs the daemon adds).",
    "verbs": {
      "workerList": {
        "verb": "worker_list",
        "format": "worker_list",
        "reply": "resp <n> <worker>:<pid>:<format>:<state>:<place>:<i>,<i>,...",
        "codes": [
          {
            "ref": "HOST_REPLY_CODES.memoryAllocation"
          },
          {
            "ref": "HOST_REPLY_CODES.invalidOperation"
          }
        ],
        "implementedBy": {
          "plugin-hostd": "required"
        },
        "doc": "The workers, one record each."
      },
      "instanceInfo": {
        "verb": "instance_info",
        "format": "instance_info %i",
        "reply": "resp 0 <worker> <pid> <state> <crashes> <quarantined>",
        "codes": [
          {
            "ref": "HOST_REPLY_CODES.instanceNonExists"
          },
          {
            "ref": "HOST_REPLY_CODES.memoryAllocation"
          },
          {
            "ref": "HOST_REPLY_CODES.invalidOperation"
          }
        ],
        "implementedBy": {
          "plugin-hostd": "required"
        },
        "doc": "Where an instance lives and what it has cost."
      },
      "supervisorReset": {
        "verb": "supervisor_reset",
        "format": "supervisor_reset ...",
        "reply": "resp 0",
        "codes": [
          {
            "ref": "PLUGIN_HOSTD_REPLY_CODES.noSuchWorker"
          },
          {
            "ref": "HOST_REPLY_CODES.memoryAllocation"
          },
          {
            "ref": "HOST_REPLY_CODES.invalidOperation"
          }
        ],
        "implementedBy": {
          "plugin-hostd": "required"
        },
        "doc": "Re-arm the storm bound and the backoff of a given-up placement: [<worker> | all]."
      },
      "quarantineClear": {
        "verb": "quarantine_clear",
        "format": "quarantine_clear %s",
        "reply": "resp 0",
        "codes": [
          {
            "ref": "HOST_REPLY_CODES.instanceNonExists"
          },
          {
            "ref": "HOST_REPLY_CODES.memoryAllocation"
          },
          {
            "ref": "HOST_REPLY_CODES.invalidOperation"
          }
        ],
        "implementedBy": {
          "plugin-hostd": "required"
        },
        "doc": "Let a quarantined instance go back where its placement says: <instance> | all."
      },
      "policySet": {
        "verb": "policy_set",
        "format": "policy_set %s %s",
        "reply": "resp 0",
        "codes": [
          {
            "ref": "PLUGIN_HOSTD_REPLY_CODES.placementInvalid"
          },
          {
            "ref": "HOST_REPLY_CODES.memoryAllocation"
          },
          {
            "ref": "HOST_REPLY_CODES.invalidOperation"
          }
        ],
        "implementedBy": {
          "plugin-hostd": "required"
        },
        "doc": "The placement of an add that says default: <format | *> own | pool:<name>."
      },
      "poolConfig": {
        "verb": "pool_config",
        "format": "pool_config %s %i",
        "reply": "resp 0",
        "codes": [
          {
            "ref": "PLUGIN_HOSTD_REPLY_CODES.placementInvalid"
          },
          {
            "ref": "HOST_REPLY_CODES.memoryAllocation"
          },
          {
            "ref": "HOST_REPLY_CODES.invalidOperation"
          }
        ],
        "implementedBy": {
          "plugin-hostd": "required"
        },
        "doc": "The instances a pool holds before a sibling opens: <name> <max_instances>."
      },
      "workerEnv": {
        "verb": "worker_env",
        "format": "worker_env %s %s %s",
        "reply": "resp 0",
        "codes": [
          {
            "ref": "HOST_REPLY_CODES.memoryAllocation"
          },
          {
            "ref": "HOST_REPLY_CODES.invalidOperation"
          }
        ],
        "implementedBy": {
          "plugin-hostd": "required"
        },
        "doc": "The cpu list and the nice value of the workers of a format, at spawn and on the ones running: <format | *> <cpu-list | -> <nice | ->."
      },
      "pinSet": {
        "verb": "pin_set",
        "format": "pin_set %s %s %s ...",
        "reply": "resp 0",
        "codes": [
          {
            "ref": "PLUGIN_HOSTD_REPLY_CODES.pinRefused"
          },
          {
            "ref": "HOST_REPLY_CODES.memoryAllocation"
          },
          {
            "ref": "HOST_REPLY_CODES.invalidOperation"
          }
        ],
        "implementedBy": {
          "plugin-hostd": "required"
        },
        "doc": "The pin of one plugin: <uri> <path>=<sha256>[,<path>=<sha256>...] <scheme>:<sha256> [verdict=<verdict>]."
      },
      "pinClear": {
        "verb": "pin_clear",
        "format": "pin_clear %s",
        "reply": "resp 0",
        "codes": [
          {
            "ref": "HOST_REPLY_CODES.memoryAllocation"
          },
          {
            "ref": "HOST_REPLY_CODES.invalidOperation"
          }
        ],
        "implementedBy": {
          "plugin-hostd": "required"
        },
        "doc": "Forget the pin of one plugin, or of every one: <uri> | all."
      },
      "pinAccept": {
        "verb": "pin_accept",
        "format": "pin_accept %s",
        "reply": "resp 0",
        "codes": [
          {
            "ref": "HOST_REPLY_CODES.pinAbsent"
          },
          {
            "ref": "PLUGIN_HOSTD_REPLY_CODES.pinBinaryMismatch"
          },
          {
            "ref": "PLUGIN_HOSTD_REPLY_CODES.pinRefused"
          },
          {
            "ref": "HOST_REPLY_CODES.memoryAllocation"
          },
          {
            "ref": "HOST_REPLY_CODES.invalidOperation"
          }
        ],
        "implementedBy": {
          "plugin-hostd": "required"
        },
        "doc": "Under pin_mode first-use, take the plugin's files as they are now as its pin: <uri>."
      },
      "pinLayout": {
        "verb": "pin_layout",
        "format": "pin_layout %i",
        "reply": "resp 0 <scheme>:<sha256>",
        "implementedBy": {
          "omx-clap-host": "optional",
          "mod-host": "unsupported"
        },
        "doc": "Sent by the daemon to a worker that checks layouts, after it accepted an add whose layout pin is unknown: the layout the worker found after init."
      },
      "lv2WorkerSet": {
        "verb": "lv2_worker_set",
        "format": "lv2_worker_set %s %s",
        "reply": "resp 0",
        "codes": [
          {
            "ref": "HOST_REPLY_CODES.memoryAllocation"
          },
          {
            "ref": "HOST_REPLY_CODES.invalidOperation"
          }
        ],
        "implementedBy": {
          "plugin-hostd": "required"
        },
        "doc": "The worker of one LV2 plugin, for its adds from now on: <uri> <mod-host | omx-clap-host | auto | ->."
      },
      "chain": {
        "verb": "chain",
        "format": "chain %i %i ...",
        "reply": "resp 0",
        "codes": [
          {
            "ref": "PLUGIN_HOSTD_REPLY_CODES.chainUnknownInstance"
          },
          {
            "ref": "PLUGIN_HOSTD_REPLY_CODES.chainDuplicate"
          },
          {
            "ref": "PLUGIN_HOSTD_REPLY_CODES.chainInstanceBusy"
          },
          {
            "ref": "PLUGIN_HOSTD_REPLY_CODES.chainMixedFormat"
          },
          {
            "ref": "PLUGIN_HOSTD_REPLY_CODES.placementInvalid"
          },
          {
            "ref": "HOST_REPLY_CODES.memoryAllocation"
          },
          {
            "ref": "HOST_REPLY_CODES.invalidOperation"
          }
        ],
        "implementedBy": {
          "plugin-hostd": "required",
          "omx-clap-host": "required",
          "mod-host": "unsupported"
        },
        "doc": "The instances, in this order, are one chain run in one worker: <chain> <instance> [<instance> ...]; a worker that runs chains in one client is sent the line with the members it holds."
      },
      "chainClear": {
        "verb": "chain_clear",
        "format": "chain_clear %i",
        "reply": "resp 0",
        "codes": [
          {
            "ref": "PLUGIN_HOSTD_REPLY_CODES.noSuchChain"
          },
          {
            "ref": "HOST_REPLY_CODES.memoryAllocation"
          },
          {
            "ref": "HOST_REPLY_CODES.invalidOperation"
          }
        ],
        "implementedBy": {
          "plugin-hostd": "required"
        },
        "doc": "Forget the chain: each member goes to a worker of its own."
      },
      "chainGet": {
        "verb": "chain_get",
        "format": "chain_get %i",
        "reply": "resp 0 <worker> <instance>,... <instance>,...",
        "codes": [
          {
            "ref": "PLUGIN_HOSTD_REPLY_CODES.noSuchChain"
          },
          {
            "ref": "HOST_REPLY_CODES.memoryAllocation"
          },
          {
            "ref": "HOST_REPLY_CODES.invalidOperation"
          }
        ],
        "implementedBy": {
          "plugin-hostd": "required"
        },
        "doc": "Read a chain back: its worker, its members in the declared order, and the members its worker runs now."
      },
      "descriptorGet": {
        "verb": "descriptor_get",
        "format": "descriptor_get %s",
        "reply": "resp 0 \"<path>\"",
        "codes": [
          {
            "ref": "PLUGIN_HOSTD_REPLY_CODES.dirNotWritable"
          },
          {
            "ref": "PLUGIN_HOSTD_REPLY_CODES.descriptorAbsent"
          },
          {
            "ref": "PLUGIN_HOSTD_REPLY_CODES.descriptorPending"
          },
          {
            "ref": "PLUGIN_HOSTD_REPLY_CODES.descriptorScanFailed"
          },
          {
            "ref": "HOST_REPLY_CODES.memoryAllocation"
          },
          {
            "ref": "HOST_REPLY_CODES.invalidOperation"
          }
        ],
        "implementedBy": {
          "plugin-hostd": "required"
        },
        "doc": "The scanned descriptor of the plugin, answered from descriptor_dir: <uri>."
      },
      "panelGet": {
        "verb": "panel_get",
        "format": "panel_get %s",
        "reply": "resp 0 \"<path>\"",
        "codes": [
          {
            "ref": "PLUGIN_HOSTD_REPLY_CODES.dirNotWritable"
          },
          {
            "ref": "PLUGIN_HOSTD_REPLY_CODES.descriptorAbsent"
          },
          {
            "ref": "PLUGIN_HOSTD_REPLY_CODES.descriptorPending"
          },
          {
            "ref": "PLUGIN_HOSTD_REPLY_CODES.descriptorScanFailed"
          },
          {
            "ref": "HOST_REPLY_CODES.memoryAllocation"
          },
          {
            "ref": "HOST_REPLY_CODES.invalidOperation"
          }
        ],
        "implementedBy": {
          "plugin-hostd": "required"
        },
        "doc": "The panel the plugin publishes, answered from descriptor_dir: <uri>."
      },
      "presetList": {
        "verb": "preset_list",
        "format": "preset_list %i",
        "reply": "resp <count>",
        "codes": [
          {
            "ref": "PLUGIN_HOSTD_REPLY_CODES.noPresetList"
          },
          {
            "ref": "HOST_REPLY_CODES.instanceNonExists"
          },
          {
            "ref": "HOST_REPLY_CODES.memoryAllocation"
          },
          {
            "ref": "HOST_REPLY_CODES.invalidOperation"
          }
        ],
        "implementedBy": {
          "plugin-hostd": "optional",
          "omx-clap-host": "optional",
          "mod-host": "unsupported"
        },
        "doc": "The plugin's presets, the ones its preset discovery or its bundle lists."
      },
      "presetGet": {
        "verb": "preset_get",
        "format": "preset_get %i %i",
        "reply": "resp 0 <load_key> <name>",
        "codes": [
          {
            "ref": "PLUGIN_HOSTD_REPLY_CODES.noPresetList"
          },
          {
            "ref": "HOST_REPLY_CODES.instanceNonExists"
          },
          {
            "ref": "HOST_REPLY_CODES.memoryAllocation"
          },
          {
            "ref": "HOST_REPLY_CODES.invalidOperation"
          }
        ],
        "implementedBy": {
          "plugin-hostd": "optional",
          "omx-clap-host": "optional",
          "mod-host": "unsupported"
        },
        "doc": "One preset, 0 to count - 1: the key preset_load takes for it, and its name."
      },
      "historyGet": {
        "verb": "history_get",
        "format": "history_get %s",
        "reply": "resp 0 <history>",
        "codes": [
          {
            "ref": "HOST_REPLY_CODES.memoryAllocation"
          },
          {
            "ref": "HOST_REPLY_CODES.invalidOperation"
          }
        ],
        "implementedBy": {
          "plugin-hostd": "required"
        },
        "doc": "What the daemon kept of one plugin on this host class, for the binary its pin holds now: <uri>. The history is one word, digest=<sha256>,class=<host class>,crashed=<0|1>,raises_xruns=<0|1> and then every key=value of PLUGIN_HOSTD_HISTORY_KEYS, joined by commas; - when the plugin has no record or no pin, unavailable while the history file is blocked."
      },
      "historyClear": {
        "verb": "history_clear",
        "format": "history_clear %s",
        "reply": "resp 0",
        "codes": [
          {
            "ref": "HOST_REPLY_CODES.memoryAllocation"
          },
          {
            "ref": "HOST_REPLY_CODES.invalidOperation"
          }
        ],
        "implementedBy": {
          "plugin-hostd": "required"
        },
        "doc": "Delete the history of one plugin, every binary and host class, or all of it: <uri> | all. Refused while the history file is blocked."
      },
      "plan": {
        "verb": "plan",
        "format": "plan %i %i ...",
        "reply": "resp 0 <instance>,...;<instance>,...;...",
        "codes": [
          {
            "ref": "PLUGIN_HOSTD_REPLY_CODES.chainUnknownInstance"
          },
          {
            "ref": "PLUGIN_HOSTD_REPLY_CODES.chainDuplicate"
          },
          {
            "ref": "PLUGIN_HOSTD_REPLY_CODES.chainInstanceBusy"
          },
          {
            "ref": "PLUGIN_HOSTD_REPLY_CODES.placementInvalid"
          },
          {
            "ref": "HOST_REPLY_CODES.memoryAllocation"
          },
          {
            "ref": "HOST_REPLY_CODES.invalidOperation"
          }
        ],
        "implementedBy": {
          "plugin-hostd": "required"
        },
        "doc": "The instances, in signal order, are planned into the fewest workers their pins and costs allow: <chain> <instance> [<instance> ...]. Each run of consecutive members that may share a worker becomes a chain of place chain:<chain>.<k>, the others stay alone in a worker of their own; the reply names the segments in order, the members of a segment joined by commas and the segments by semicolons. With the setting grouping off the plan is answered and kept, and nothing moves."
      },
      "planGet": {
        "verb": "plan_get",
        "format": "plan_get %i",
        "reply": "resp 0 <instance>,...;<instance>,...;... <instance>:<reason>,...",
        "codes": [
          {
            "ref": "PLUGIN_HOSTD_REPLY_CODES.noSuchPlan"
          },
          {
            "ref": "HOST_REPLY_CODES.memoryAllocation"
          },
          {
            "ref": "HOST_REPLY_CODES.invalidOperation"
          }
        ],
        "implementedBy": {
          "plugin-hostd": "required"
        },
        "doc": "Read the last plan of a chain back: its segments as plan answered them, then the reason of each member that has one (a word of PLUGIN_HOSTD_GROUPING_REASONS, plan-refused followed by the refusal's number), instance:reason joined by commas, - for none."
      },
      "planClear": {
        "verb": "plan_clear",
        "format": "plan_clear %i",
        "reply": "resp 0",
        "codes": [
          {
            "ref": "PLUGIN_HOSTD_REPLY_CODES.noSuchPlan"
          },
          {
            "ref": "HOST_REPLY_CODES.memoryAllocation"
          },
          {
            "ref": "HOST_REPLY_CODES.invalidOperation"
          }
        ],
        "implementedBy": {
          "plugin-hostd": "required"
        },
        "doc": "Forget the plan: each member goes to a worker of its own, as chain_clear does."
      },
      "estimate": {
        "verb": "estimate",
        "format": "estimate %i %i %s ...",
        "reply": "resp 0 <latency_frames> <cpu_percent> <ram_bytes> <workers> <unknown_count> <member>:<code>,...",
        "codes": [
          {
            "ref": "PLUGIN_HOSTD_REPLY_CODES.noRecord"
          },
          {
            "ref": "PLUGIN_HOSTD_REPLY_CODES.noCell"
          },
          {
            "ref": "PLUGIN_HOSTD_REPLY_CODES.unknownPlugin"
          },
          {
            "ref": "HOST_REPLY_CODES.memoryAllocation"
          },
          {
            "ref": "HOST_REPLY_CODES.invalidOperation"
          }
        ],
        "implementedBy": {
          "plugin-hostd": "required"
        },
        "doc": "What a chain of these plugins would cost at a rate and a quantum, read from the qualification records with no plugin loaded: <rate> <quantum> <uri> [<uri> ...], the uris as add takes them, in signal order. The reply is the latency in frames (each member's measured latency, else its declared one, added up), the CPU as percent of one core's cycle (each member's median nanoseconds per sample times the rate, added up), the RAM in bytes (the Pss each member's worker had running alone on this host class, added up; - unless every member has one), the workers plan would place the members in, and how many members have no figure at that rate and quantum; then each of those as its position in the line, from 0, and its code (noRecord, noCell or unknownPlugin), joined by commas, - for none. The latency and the CPU add up only the members that have a figure."
      }
    }
  }
}
