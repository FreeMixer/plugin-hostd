#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_build:
	# PREFIX at the build too: the probe compiles in where its lock preload is installed
	dh_auto_build -- PREFIX=/usr
	dh_auto_build -- PREFIX=/usr tests/fake-host

override_dh_auto_install:
	dh_auto_install -- PREFIX=/usr
	# the format tables and the verbs, as the package plugin-hostd of omx-contract's contract directory (docs/formats.md)
	$(MAKE) install-contract DESTDIR=$(CURDIR)/debian/tmp PREFIX=/usr

# the verb table is checked against mod-host's README, which a build does not have
override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	$(MAKE) test-daemon check-generated check-rendered
endif

# the protocol clients are sourced and imported, never run: no execute bit
override_dh_fixperms:
	dh_fixperms
	chmod 0644 debian/plugin-hostd-tests/usr/libexec/plugin-hostd/tests/lib/protocol.sh debian/plugin-hostd-tests/usr/libexec/plugin-hostd/tests/lib/plugin_hostd_client.py
